{
  "name": "matongduoclieu-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "post:local": "node scripts/publish-post.mjs",
    "post:publish": "node scripts/publish-post.mjs --remote",
    "admin:password": "node scripts/set-admin-password.mjs",
    "template:export": "node scripts/export-template.mjs",
    "post:check": "node scripts/check-post.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
